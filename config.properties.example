# ============================================================
#  Gesty – JEDYNE miejsce na konfigurację logowania i serwera
# ============================================================
# Skopiuj ten plik jako config.properties i wpisz własne wartości.
# config.properties jest w .gitignore i nie trafia do repozytorium.
# Po zmianie: zbuduj apkę ponownie (Build > Rebuild / gradlew assembleRelease).
# Dopóki są tu placeholdery, apka działa normalnie w trybie „bez logowania”.

# Firebase Console > Authentication > Sign-in method > Google > Web SDK configuration > Web client ID
# (kończy się na .apps.googleusercontent.com)
WEB_CLIENT_ID=WKLEJ_WEB_CLIENT_ID.apps.googleusercontent.com

# Adres Twojego serwera z HTTPS, bez ukośnika na końcu, np. https://api.twojadomena.pl
API_BASE_URL=https://WKLEJ_ADRES_SERWERA
